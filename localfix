    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Poppins:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
        /* Reset and base styles */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: #ffffff;
            color: #333;
            line-height: 1.6;
        }

        /* Typography */
        h1, h2 {
            font-family: 'Playfair Display', serif;
        }

        /* Hero Section */
        .hero {
            text-align: center;
            padding: 4rem 2rem;
            position: relative;
        }

        .hero h1 {
            font-size: 3rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
            display: inline-block;
            background-color: #FFFFFF;
            padding: 0.5rem 1rem;
            border-radius: 100px;
            color: #333;
        }

        .hero p {
            font-size: 1.2rem;
            font-weight: 300;
        }

        /* Description Section */
        .description {
            padding: 2rem;
            max-width: 800px;
            margin: 0 auto;
            text-align: center;
        }

        .description p {
            font-size: 1rem;
            margin-bottom: 2rem;
            display: inline-block;
            background-color: #FFFFFF;
            color: #000000;
            padding: 1rem 1.5rem;
            border-radius: 15px;
            line-height: 1.8;
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15);
        }

        /* Products Section */
        .products {
            padding: 2rem;
        }

        .products h2 {
            text-align: center;
            font-size: 2rem;
            margin-bottom: 2rem;
        }

        .product-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1.5rem;
            max-width: 1200px;
            margin: 0 auto;
        }

        .product-card {
            background-color: #fff;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            overflow: hidden;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15);
        }

        .product-image {
            width: 100%;
            height: 200px;
            object-fit: cover;
        }

        .product-info {
            padding: 1rem;
            text-align: center;
        }

        .product-name {
            font-size: 1.1rem;
            font-weight: 500;
            margin-bottom: 0.5rem;
        }

        .product-price {
            font-size: 1rem;
            color: #666;
        }

        /* Footer */
        .footer {
            text-align: center;
            padding: 2rem;
            background-color: #f9f9f9;
        }

        .footer p {
            font-size: 0.9rem;
        }

        .footer a {
            color: #333;
            text-decoration: none;
        }

        .footer a:hover {
            text-decoration: underline;
        }

        /* Media Queries */
        /* Tablet */
        @media (min-width: 768px) {
            .hero h1 {
                font-size: 4rem;
            }

            .hero p {
                font-size: 1.5rem;
            }

            .product-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        /* Desktop */
        @media (min-width: 1024px) {
            .hero h1 {
                font-size: 5rem;
            }

            .hero p {
                font-size: 1.8rem;
            }

            .product-grid {
                grid-template-columns: repeat(6, 1fr);
            }
        }
    </style>
</head>
